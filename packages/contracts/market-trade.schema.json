{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketTradeEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "source",
    "symbol",
    "exchange_at",
    "received_at",
    "price",
    "quantity",
    "side"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "const": "market.trade"
    },
    "source": {
      "enum": [
        "mock",
        "bithumb_public"
      ]
    },
    "symbol": {
      "type": "string",
      "pattern": "^KRW-[A-Z0-9]+$"
    },
    "exchange_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "price": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "side": {
      "enum": [
        "BUY",
        "SELL",
        "UNKNOWN"
      ]
    },
    "connection_id": {
      "type": "string",
      "minLength": 1
    },
    "stream_type": {
      "enum": [
        "SNAPSHOT",
        "REALTIME",
        "UNKNOWN"
      ]
    },
    "exchange_timestamp_unit": {
      "enum": [
        "milliseconds",
        "microseconds"
      ]
    },
    "raw_exchange_timestamp": {
      "type": "string",
      "pattern": "^[0-9]+$"
    }
  }
}
