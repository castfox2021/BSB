{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketOrderbookEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "symbol",
    "exchange_at",
    "received_at",
    "connection_id",
    "stream_type",
    "exchange_timestamp_unit",
    "raw_exchange_timestamp",
    "event_id",
    "event_type",
    "asks",
    "bids"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "source": {
      "enum": [
        "mock",
        "bithumb_public"
      ]
    },
    "symbol": {
      "type": "string",
      "pattern": "^KRW-[A-Z0-9]+$"
    },
    "exchange_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "connection_id": {
      "type": "string",
      "minLength": 1
    },
    "stream_type": {
      "enum": [
        "SNAPSHOT",
        "REALTIME",
        "UNKNOWN"
      ]
    },
    "exchange_timestamp_unit": {
      "enum": [
        "milliseconds",
        "microseconds"
      ]
    },
    "raw_exchange_timestamp": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "const": "market.orderbook"
    },
    "asks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      }
    },
    "bids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      }
    }
  }
}
