POSTGRES_USER=bsb
POSTGRES_PASSWORD=bsb_local_only
POSTGRES_DB=bsb
DATA_SOURCE=mock
WEB_PORT=3000
API_PORT=3001
PYTHON_PORT=8000

# Collector only: mock (idle) or bithumb_public (public data, never real orders)
COLLECTOR_SOURCE=mock
COLLECTOR_BATCH_SIZE=100
COLLECTOR_REFRESH_SECONDS=300
COLLECTOR_STALE_SECONDS=15
COLLECTOR_RECEIVE_TIMEOUT=30
COLLECTOR_STREAM_MAXLEN=100000

# Durable market-data pipeline (select the same source as the collector for live ingest)
PIPELINE_SOURCE=mock
PIPELINE_PORT=8001
PIPELINE_BATCH_SIZE=200
PIPELINE_LATENESS_SECONDS=40
PIPELINE_MAX_DELAY_SECONDS=15
PIPELINE_HEARTBEAT_TIMEOUT=15

# Private API integration: set NEW rotated keys only in root .env (chmod 600).
# Never paste keys into chat. Orders additionally require user UI activation and per-order confirmation.
BITHUMB_PRIVATE_ENABLED=false
BITHUMB_KEYS_ROTATED=false
BITHUMB_ACCESS_KEY=
BITHUMB_SECRET_KEY=
# Legacy flag is ignored; it cannot activate orders.
LIVE_ORDER_ENABLED=false
